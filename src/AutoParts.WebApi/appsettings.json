{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/autoparts-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=autoparts;Username=srisukarki"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast64CharactersLongForHmacSha256Signing2026!!",
    "Issuer": "AutoParts.WebApi",
    "Audience": "AutoParts.WebApp",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:5173"
  },
  "GoogleAuth": {
    "ClientId": "REPLACE_ME",
    "ClientSecret": "REPLACE_ME",
    "RedirectUri": "postmessage"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "REPLACE_ME",
    "Password": "REPLACE_ME",
    "FromAddress": "REPLACE_ME",
    "FromName": "AutoParts",
    "UseStartTls": true
  }
}
